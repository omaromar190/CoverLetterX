{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "outDir": ".wasp/phantom",
    "composite": true,
    "skipLibCheck": true,
    "typeRoots": ["node_modules/@testing-library", "node_modules/@types"],
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["src"]
}
